PORT=8080
DATABASE_URL=postgres://mia:mia@localhost:5444/mia?sslmode=disable
CORS_ORIGINS=http://localhost:5173

# segredo usado para assinar os tokens de acesso (obrigatorio, minimo 32 caracteres)
# gere um com: openssl rand -hex 32
JWT_SECRET=

# validade do token em minutos (padrao 480 = 8 horas)
JWT_EXPIRA_MINUTOS=480

# onde os anexos das solicitacoes sao gravados: "disco" (padrao) ou "r2"
STORAGE_DRIVER=disco

# diretorio do driver disco (padrao storage_local)
STORAGE_DIR=storage_local

# credenciais do cloudflare r2 (obrigatorias quando STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
